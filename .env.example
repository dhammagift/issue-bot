# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# GitHub personal access token (repo scope) used to create issues and upload images
GITHUB_TOKEN=

# Comma-separated list of repos allowed for issue creation, format owner/repo
GITHUB_REPOS=owner/repo1,owner/repo2

# Optional: restrict bot usage to these Telegram user IDs (comma-separated). Empty = allow everyone.
ALLOWED_USER_IDS=

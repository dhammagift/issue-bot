# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# GitHub personal access token (repo scope) used to create issues and upload images
GITHUB_TOKEN=

# Optional: comma-separated list of repos allowed for issue creation, format owner/repo.
# Leave empty to auto-discover all repos accessible to GITHUB_TOKEN.
GITHUB_REPOS=

# Optional: restrict bot usage to these Telegram user IDs (comma-separated). Empty = allow everyone.
ALLOWED_USER_IDS=

# Optional: Groq API key (free tier) for voice message transcription
GROQ_API_KEY=

# Optional: repo where photos, videos and files from issues are committed (default dhammagift/issue-media)
MEDIA_REPO=

# Optional: Trello board whose lists are offered as targets next to the repos ("Done" creates a card there,
# attachments go onto the card). TRELLO_BOARD is the board id or its short link (from trello.com/b/<shortLink>).
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD=
# Optional: a label id put on every card the bot creates
TRELLO_LABEL_ID=
